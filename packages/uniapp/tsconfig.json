{
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "baseUrl": "./"
  },
  "include": ["src/uni_modules/**/*.ts"],
  "exclude": ["node_modules", "src/uni_modules/tdesign-icons-uniapp/components"]
}
