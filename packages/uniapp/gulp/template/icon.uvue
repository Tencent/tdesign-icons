<template>
  <view class="t-icon-root" :class="_classNames" :style="_rootStyle" @click="onClick">
    <image class="t-icon-image" :src="_src" mode="aspectFit" :style="_imageStyle" />
  </view>
</template>

<script setup lang="uts">
import { computed, PropType } from 'vue'
import {
  IconColor,
  IconSizeStyle,
  SIZE_CLASS_NAMES,
  resolveSizeStyle,
  resolveSvg,
  toSvgDataUri,
} from '../utils/icon-runtime.uts'

/**
 * 图标模板：由 `pnpm run generate` 生成，请勿手动修改。
 * 颜色占位符 {f1}/{f2}/{s1}/{s2} 与描边宽度占位符 {sw} 在运行时由 icon-runtime 解析。
 */
const TEMPLATE = `$TEMPLATE`

const props = defineProps({
  /** 图标尺寸，支持 'small' | 'medium' | 'large' | '20px' | '1.5em' | 数字(px) */
  size: {
    type: String,
    default: '',
  },
  /** 描边颜色，支持 string 或 string[]，多色图标按顺序取用 */
  strokeColor: {
    type: [String, Array] as PropType<IconColor>,
    default: null,
  },
  /** 填充颜色，支持 string 或 string[]，多色图标按顺序取用 */
  fillColor: {
    type: [String, Array] as PropType<IconColor>,
    default: null,
  },
  /** 描边宽度 */
  strokeWidth: {
    type: Number,
    default: 2,
  },
  /** 点击事件 */
  onClick: {
    type: Function as PropType<() => void>,
    default: null,
  },
})

const iconName = '$KEY'

const _src = computed((): string => toSvgDataUri(
  resolveSvg(
    TEMPLATE,
    props.strokeColor as IconColor | null,
    props.fillColor as IconColor | null,
    props.strokeWidth,
  ),
))

const _sizeStyle = computed((): IconSizeStyle => resolveSizeStyle(props.size))

const _classNames = computed((): string => {
  const sizeClass = SIZE_CLASS_NAMES[props.size]
  return sizeClass != null ? `t-icon t-icon-${iconName} ${sizeClass}` : `t-icon t-icon-${iconName}`
})

const _rootStyle = computed((): string => {
  const sizeStyle = _sizeStyle.value
  if (sizeStyle.width == null) {
    return 'display:inline-block;vertical-align:middle;'
  }
  return `display:inline-block;vertical-align:middle;width:${sizeStyle.width};height:${sizeStyle.height};`
})

const _imageStyle = computed((): string => 'width:100%;height:100%;display:block;')
</script>

<style>
@import '../style/index.css';
</style>
