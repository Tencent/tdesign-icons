{
  "name": "tdesign-icons-web-components",
  "version": "0.3.7",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tencent/tdesign-icons.git",
    "directory": "packages/web-components"
  },
  "homepage": "https://github.com/Tencent/tdesign-icons/blob/develop/README.md",
  "bugs": {
    "url": "https://github.com/Tencent/tdesign-icons/issues"
  },
  "contributors": [
    "duenyang"
  ],
  "files": [
    "dist/",
    "esm/",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "lib/index.js",
  "module": "esm/index.js",
  "unpkg": "dist/index.min.js",
  "sideEffects": [
    "dist/**/*",
    "esm/**/*",
    "lib/**/*"
  ],
  "scripts": {
    "prebuild": "rimraf esm/* lib/* dist/*",
    "build": "cross-env NODE_ENV=production rolldown -c rolldown.config.mjs && npm run build:tsc",
    "build:tsc": "concurrently \"npm:build:tsc-*\"",
    "build:tsc-esm": "tsc --emitDeclarationOnly -d --outDir esm/",
    "build:tsc-lib": " tsc --emitDeclarationOnly -d --outDir lib/"
  },
  "peerDependencies": {
    "omi": ">=7.6.17"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-runtime": "catalog:",
    "@babel/preset-env": "catalog:",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/node": "catalog:types",
    "camelcase": "catalog:",
    "concurrently": "catalog:",
    "cross-env": "catalog:",
    "rimraf": "catalog:",
    "rolldown": "1.2.3",
    "tslib": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@babel/runtime": "catalog:",
    "clsx": "catalog:",
    "omi": "catalog:",
    "tailwind-merge": "catalog:"
  }
}
